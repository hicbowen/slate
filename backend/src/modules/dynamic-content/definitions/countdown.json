{
  "type": "countdown",
  "default_ttl_sec": 86400,
  "layout": {
    "size": [400, 300],
    "padding": 16,
    "top_offset": 24,
    "body": [
      {
        "block": "centered_text",
        "field": "config.goal",
        "size": 18,
        "font": "sans",
        "weight": "bold"
      },
      {
        "block": "centered_text",
        "field": "config.target_date",
        "size": 16,
        "font": "mono"
      },
      {
        "block": "big_number",
        "field": "data.remainingDays",
        "size": 64,
        "suffix": "天",
        "align": "center",
        "font": "mono"
      }
    ]
  }
}
